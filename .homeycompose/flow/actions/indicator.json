{
  "title": {
    "en": "Show [[indicator]] indicator with [[color]] color and [[effect]] effect for [[duration]]"
  },
  "titleFormatted": {
    "en": "Show [[indicator]] indicator with [[color]] color and [[effect]] effect for [[duration]]"
  },
  "hint": {
    "en": "Set an indicator. Effect duration is in milliseconds."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=awtrixlight|awtrixng"
    },
    {
      "type": "color",
      "name": "color",
      "title": {
        "en": "color"
      }
    },
    {
      "type": "dropdown",
      "name": "indicator",
      "value": "1",
      "title": {
        "en": "indicator number"
      },
      "values": [
        {
          "id": "1",
          "title": {
            "en": "top right"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "right"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "bottom right"
          }
        }
      ]
    },
    {
      "type": "dropdown",
      "name": "effect",
      "value": "fade",
      "title": {
        "en": "effect"
      },
      "values": [
        {
          "id": "-",
          "title": {
            "en": "no"
          }
        },
        {
          "id": "blink",
          "title": {
            "en": "blink"
          }
        },
        {
          "id": "fade",
          "title": {
            "en": "fade"
          }
        }
      ]
    },
    {
      "type": "range",
      "name": "duration",
      "value": 1000,
      "title": {
        "en": "effect duration"
      },
      "min": 500,
      "max": 10000,
      "step": 100,
      "label": "ms",
      "labelMultiplier": 1,
      "labelDecimals": 0
    }
  ]
}
