{
  "title": {
    "en": "Create or update an application"
  },
  "titleFormatted": {
    "en": "Create/update application [[name]] [[msg]] [[icon]] [[color]] [[options]]"
  },
  "hint": {
    "en": "Create or update an application. Name must match A-Z, a-z, 0-9, _ or - and be at most 26 characters. Optional options must be device-specific JSON. Use Homey's Add duration option to override the JSON options or the device default duration."
  },
  "duration": true,
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=awtrixlight|awtrixng"
    },
    {
      "type": "text",
      "name": "name",
      "placeholder": {
        "en": "app name"
      }
    },
    {
      "type": "text",
      "name": "msg",
      "required": false,
      "placeholder": {
        "en": "message"
      }
    },
    {
      "type": "autocomplete",
      "name": "icon",
      "required": false,
      "title": {
        "en": "icon"
      },
      "placeholder": {
        "en": "icon"
      }
    },
    {
      "type": "color",
      "name": "color",
      "required": false,
      "value": "#eeeeee",
      "title": {
        "en": "color"
      }
    },
    {
      "type": "text",
      "name": "options",
      "required": false,
      "placeholder": {
        "en": "JSON options"
      }
    }
  ]
}
