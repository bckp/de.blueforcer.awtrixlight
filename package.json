{
  "name": "de.blueforcer.awtrixlight",
  "version": "2.2.9",
  "main": "app.ts",
  "scripts": {
    "build": "tsc && node scripts/copy-driver-assets.js",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "test": "npm run build && node --test test/*.test.js",
    "publish-app": "homey app publish && node scripts/sync-version.js",
    "sync-version": "node scripts/sync-version.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.1",
    "eslint-config-athom": "^4.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
