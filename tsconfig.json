{
  "extends": "@tsconfig/node16/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": ".homeybuild/",
    "target": "ES6",
    "lib": ["es6", "dom"],
    "baseUrl": ".",
    "paths": {
      "drivers/*": ["drivers/*"],
      "lib/*": ["lib/*"]
    }
  },
  "exclude": [".homeybuild", "node_modules", "test"]
}
