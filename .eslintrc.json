{
  "extends": [
    "athom",
    "plugin:import/recommended",
    "plugin:import/typescript"
  ],
  "rules": {
    // Off: the offending signatures put optional parameters after a defaulted one
    // (Api.clientVerify, FetchTransport constructor options). Reordering them would
    // change public call signatures, which a lint upgrade must not do.
    "default-param-last": "off",
    "node/no-unsupported-features/es-syntax": [
      "error",
      {
        "ignores": [
          "modules"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.ts", "**/*.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "strict": "off",
        "node/no-missing-import": "off",
        "import/extensions": [
          "error",
          "ignorePackages",
          {
            "ts": "never"
          }
        ]
      }
    },
    {
      // Homey requires driver/device/app entrypoints to assign module.exports next to the
      // ES export (enforced by test/awtrixng-homey-entrypoints.test.js), which is exactly
      // what import/no-import-module-exports forbids.
      "files": ["app.ts", "drivers/*/device.ts", "drivers/*/driver.ts"],
      "rules": {
        "import/no-import-module-exports": "off"
      }
    },
    {
      "files": ["test/**/*.js"],
      "env": {
        "node": true
      },
      "rules": {
        "mocha/no-global-tests": "off",
        "node/no-unpublished-require": "off"
      }
    }
  ],
  "settings": {
    "import/core-modules": [
      "homey",
      "homey/lib/Device",
      "homey/lib/PairSession"
    ],
    "import/resolver": {
        "typescript": {
          "directory": "./tsconfig.json"
        },
        "node": true
    },
    "import/parsers": {
      "@typescript-eslint/parser": [".ts", ".tsx"]
    }
  }
}
