{
  "name": {
    "en": "Awtrix NG"
  },
  "class": "other",
  "capabilities": [
    "button_prev",
    "button_next",
    "alarm_generic.indicator1",
    "alarm_generic.indicator2",
    "alarm_generic.indicator3",
    "awtrix_matrix",
    "awtrixng_weather_overlay",
    "rssi",
    "ip",
    "button.rediscover"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "capabilitiesOptions": {
    "alarm_generic.indicator1": {
      "preventInsights": true,
      "title": {
        "en": "Indicator top"
      }
    },
    "alarm_generic.indicator2": {
      "preventInsights": true,
      "title": {
        "en": "Indicator middle"
      }
    },
    "alarm_generic.indicator3": {
      "preventInsights": true,
      "title": {
        "en": "Indicator bottom"
      }
    },
    "button.rediscover": {
      "maintenanceAction": true,
      "title": {
        "en": "Try to discover"
      },
      "desc": {
        "en": "Start discovery process for new IP of device."
      }
    }
  },
  "discovery": "awtrixng-mdns",
  "pair": [
    {
      "id": "list_my_devices",
      "template": "list_devices",
      "navigation": {
        "next": "pair_selection_router"
      },
      "options": {
        "singular": true
      }
    },
    {
      "id": "pair_selection_router"
    },
    {
      "id": "manual_pairing_placeholder"
    },
    {
      "id": "credentials_placeholder"
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  }
}
